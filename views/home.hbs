{{#> layout isUserLoggedIn=isUserLoggedIn}}

  <script defer src="scripts/home.js"></script>

  <h3 class="mb-3">Your Playlists</h3>
  <p>You currently have <strong>{{numberOfPlaylists}}</strong> playlists saved in Spotify!</p>

  {{#if samplePlaylistData.length > 0}}
    <p>Some of your playlists are listed below!</p>

    <div id="playlists" class="table-responsive">
      <table class="table table-striped table-sm table-hover small">
        <thead>
          <tr>
            <th scope="col" class="align-middle">Playlist #</th>
            <th scope="col" class="align-middle">Name</th>
            <th scope="col" class="align-middle">Owner</th>
            <th scope="col" class="align-middle">Link</th>
            <th scope="col" class="align-middle">Image</th>
          </tr>
        </thead>
        <tbody>
          {{#each samplePlaylistData}}
            <tr>
              <th scope="row" class="align-middle">{{@index + 1}}</th>
              <td class="align-middle text-capitalize">{{this.name}}</td>
              <td class="align-middle">{{this.owner.display_name}}</td>
              <td class="align-middle">
                <a id="viewPlaylistLink-{{@index + 1}}" href="/playlist?playlistId={{this.id}}" role="button"
                  class="btn btn-outline-info btn-sm">
                  View
                </a>
              </td>
              <td class="align-middle col-2 col-lg-1">
                <img id="imageForPlaylist-{{@index + 1}}" class="img-fluid" alt="Playlist Named {{this.name}}" />
                <script type="text/javascript">
                  var images = {{ this.images }};
                  var defaultImagePath = "images/question.png";
                  var playlistImagePath = getImagePath(images, defaultImagePath);

                  setImageSourceAttributeById("imageForPlaylist-{{@index + 1}}", playlistImagePath);
                </script>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <div id="interact" class="row align-middle mt-3 mb-5">
    <div class="col">
      <a id="seeAllPlaylistsButton" href="/playlists" role="button" class="btn btn-info btn-sm">See All Playlists</a>
    </div>
    <div class="col">
      <a id="createSmartPlaylistButton" href="/createSmartPlaylist" role="button" class="btn btn-info btn-sm">Create
        Smart Playlist</a>
    </div>
  </div>

  <h3 class="my-3">Your Library</h3>
  <p>You currently have <strong>{{numberOfTracks}}</strong> songs saved in Spotify!</p>

  {{#if sampleTrackData.length > 0}}
    <h6 class="my-4">Your Top Tracks</h6>

    <div id="songs" class="table-responsive">
      <table class="table table-striped table-sm table-hover small">
        <thead>
          <tr>
            <th scope="col" class="align-middle">Track #</th>
            <th scope="col" class="align-middle">Title</th>
            <th scope="col" class="align-middle">Artist</th>
            <th scope="col" class="align-middle">Album</th>
            <th scope="col" class="align-middle">Album Art</th>
          </tr>
        </thead>
        <tbody>
          {{#each sampleTrackData}}
            <tr>
              <th scope="row" class="align-middle">{{@index + 1}}</th>
              <td class="align-middle text-capitalize">{{this.name}}</td>

              <td id="artistNamesForTrack-{{@index + 1}}" class="align-middle text-capitalize"></td>
              <script type="text/javascript">
                var artists = {{ this.artists }};
                var commaSeparatedArtistNames = getCommaSeparatedArtistNames(artists);

                setTextInElementById("artistNamesForTrack-{{@index + 1}}", commaSeparatedArtistNames);
              </script>

              <td class="align-middle text-capitalize">{{this.album.name}}</td>
              <td class="align-middle col-2 col-lg-1">
                <img id="albumImageForTrack-{{@index + 1}}" class="img-fluid" alt="Album Named {{this.album.name}}" />
                <script type="text/javascript">
                  var images = {{ this.album.images }};
                  var defaultImagePath = "images/question.png";
                  var albumImagePath = getImagePath(images, defaultImagePath);

                  setImageSourceAttributeById("albumImageForTrack-{{@index + 1}}", albumImagePath);
                </script>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <h3 class="my-3">Your Artists</h3>
  <p>You currently have <strong>{{numberOfArtists}}</strong> artists saved in Spotify!</p>

  {{#if sampleArtistData.length > 0}}
    <h6 class="my-4">Your Top Artists</h6>

    <div id="artists" class="table-responsive">
      <table class="table table-striped table-sm table-hover small">
        <thead>
          <tr>
            <th scope="col" class="align-middle">Artist #</th>
            <th scope="col" class="align-middle">Artist Name</th>
            <th scope="col" class="align-middle">Followers</th>
            <th scope="col" class="align-middle">Genres</th>
            <th scope="col" class="align-middle">Image</th>
          </tr>
        </thead>
        <tbody>
          {{#each sampleArtistData}}
            <tr>
              <th scope="row" class="align-middle">{{@index + 1}}</th>
              <td class="align-middle text-capitalize">{{this.name}}</td>
              <td id="followersForArtist-{{@index + 1}}" class="align-middle"></td>
              <script type="text/javascript">
                var significantFigures = 3;
                var followersCount = getShortenedNumericRepresentation({{ this.followers.total }}, significantFigures);

                setTextInElementById("followersForArtist-{{@index + 1}}", followersCount);
              </script>
              <td class="align-middle text-capitalize">
                {{#each this.genres}}
                  {{this}}
                  <br />
                {{/each}}
              </td>
              <td class="align-middle col-2 col-lg-1">
                <img id="imageForArtist-{{@index + 1}}" class="img-fluid" alt="Artist Named {{this.name}}" />
                <script type="text/javascript">
                  var images = {{ this.images }};
                  var defaultImagePath = "images/question.png";
                  var artistImagePath = getImagePath(images, defaultImagePath);

                  setImageSourceAttributeById("imageForArtist-{{@index + 1}}", artistImagePath);
                </script>
              </td>
            </tr>
            })
        </tbody>
      </table>
    </div>
  {{/if}}
{{/layout}}